[user]
    name = "Justin Lubin"
    email = "jlubi333@gmail.com"

[core]
	excludesFile = ~/.config/git/ignore
    autocrlf = input

[push]
    default = simple
    autoSetupRemote = true

[pull]
    ff = only

[merge]
    conflictstyle = diff3

[mergetool]
    prompt = false

[color]
    ui = true

[credential]
    helper = osxkeychain

[init]
    defaultBranch = main
